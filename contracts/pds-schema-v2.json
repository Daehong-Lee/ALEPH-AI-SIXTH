{
  "schema_version": "pds-schema-v2",
  "timezone": {
    "storage": "timestamptz/UTC",
    "display": "Asia/Seoul",
    "date_rule": "지연 여부는 서울 시간(Asia/Seoul)의 오늘 날짜보다 due_date가 앞선 미완료 task만 지연으로 계산"
  },
  "tables": {
    "plans": {
      "pk": "id uuid",
      "fields": [
        "title",
        "start_date",
        "end_date",
        "priority",
        "success_criteria",
        "expected_minutes",
        "created_at",
        "updated_at"
      ]
    },
    "plan_versions": {
      "pk": "id uuid",
      "fk": [
        "plan_id -> plans.id"
      ],
      "purpose": "계획 UPDATE 직전 OLD 값을 보존"
    },
    "tasks": {
      "pk": "id uuid",
      "fk": [
        "plan_id -> plans.id"
      ],
      "fields": [
        "title",
        "due_date",
        "priority",
        "tags",
        "expected_minutes",
        "status",
        "deleted_at",
        "created_at",
        "updated_at"
      ]
    },
    "task_completions": {
      "pk": "id uuid",
      "unique": [
        "task_id"
      ],
      "fk": [
        "task_id -> tasks.id"
      ],
      "purpose": "완료 중복 방지"
    },
    "execution_logs": {
      "pk": "id uuid",
      "fk": [
        "task_id -> tasks.id"
      ],
      "fields": [
        "started_at",
        "ended_at",
        "actual_minutes",
        "blocked_reason",
        "created_at"
      ]
    },
    "review_notes": {
      "pk": "id uuid",
      "fields": [
        "note",
        "created_at"
      ]
    }
  },
  "relationships": [
    "plans 1:N tasks",
    "plans 1:N plan_versions",
    "tasks 1:0..1 task_completions",
    "tasks 1:N execution_logs"
  ],
  "review_rules": {
    "plan_count": "삭제되지 않은 task 수",
    "completed_count": "현재 done 상태인 task 수",
    "delayed_count": "미완료이고 서울 시간 기준 오늘보다 due_date가 이전인 task 수",
    "blocked_count": "blocked_reason이 하나라도 적힌 execution_log를 가진 task 수",
    "expected_minutes": "대상 task의 expected_minutes 합계",
    "actual_minutes": "대상 task에 연결된 execution_logs.actual_minutes 합계",
    "difference_minutes": "actual_minutes - expected_minutes",
    "completion_idempotency": "complete_task_once RPC + task_completions.task_id UNIQUE"
  },
  "security": {
    "authentication": "none",
    "public_access": "anon can CRUD in this assignment only",
    "secret_policy": "service_role/secret key must never be shipped to browser"
  }
}